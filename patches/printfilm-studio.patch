@@ -0,0 +1,31 @@
+import { setCachedUser, setToken, type AdminUser } from './auth'
+
+let localAdmin = false
+let preparation: Promise<void> | undefined
+
+export function isLocalAdminMode() {
+  return localAdmin
+}
+
+async function prepare() {
+  const mode = await fetch('/api/auth/session-mode', { cache: 'no-store', signal: AbortSignal.timeout(10000) })
+  if (!mode.ok) throw new Error('无法连接本机模型管理服务。')
+  if ((await mode.json()).local_single_user !== true) return
+  const session = await fetch('/api/auth/local-session', { method: 'POST', cache: 'no-store', headers: { 'X-Printfilm-Local': '1' }, signal: AbortSignal.timeout(10000) })
+  if (!session.ok) throw new Error('本机管理会话建立失败，请重试。')
+  const result = await session.json()
+  if (typeof result.access_token !== 'string' || !result.access_token) throw new Error('本机服务未返回有效会话。')
+  const profile = await fetch('/api/auth/me', { headers: { Authorization: 'Bearer ' + result.access_token }, cache: 'no-store', signal: AbortSignal.timeout(10000) })
+  if (!profile.ok) throw new Error('无法读取本机账号资料。')
+  const user: AdminUser = await profile.json()
+  // 复用的已有账号仍遵循原管理员权限，不自动提升权限。
+  if (user.role !== 'admin') return
+  setToken(result.access_token)
+  setCachedUser(user)
+  localAdmin = true
+}
+
+export function prepareLocalAdminSession() {
+  preparation ??= prepare().catch(error => { preparation = undefined; throw error })
+  return preparation
+}
