@@ -0,0 +1,32 @@
+import { API_BASE } from '../api/client'
+
+let localSingleUser = false
+let preparation: Promise<void> | undefined
+
+export function isLocalSingleUserMode() {
+  return localSingleUser
+}
+
+async function requestSession() {
+  const mode = await fetch(API_BASE + '/api/auth/session-mode', { cache: 'no-store', signal: AbortSignal.timeout(10000) })
+  if (!mode.ok) throw new Error('无法读取工作台运行模式，请检查本机服务。')
+  const status = await mode.json()
+  if (status.local_single_user !== true) return
+  const response = await fetch(API_BASE + '/api/auth/local-session', {
+    method: 'POST', cache: 'no-store', signal: AbortSignal.timeout(10000), headers: { 'X-Printfilm-Local': '1' },
+  })
+  if (!response.ok) {
+    const error = await response.json().catch(() => null)
+    throw new Error(typeof error?.detail === 'string' ? error.detail : '本机工作台会话建立失败，请重试。')
+  }
+  const session = await response.json()
+  if (typeof session.access_token !== 'string' || !session.access_token) throw new Error('本机服务未返回有效会话。')
+  localStorage.setItem('token', session.access_token)
+  localSingleUser = true
+}
+
+/** 启动时统一准备会话，开发模式重复挂载也只发起一次请求，失败后允许重试。 */
+export function prepareLocalStudioSession() {
+  preparation ??= requestSession().catch(error => { preparation = undefined; throw error })
+  return preparation
+}
