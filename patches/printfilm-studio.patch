diff --git a/backend/app/services/local_studio.py b/backend/app/services/local_studio.py
new file mode 100644
index 0000000..8133a53
--- /dev/null
+++ b/backend/app/services/local_studio.py
@@ -0,0 +1,81 @@
+"""本机工作室会话：固定用户身份，业务接口继续使用原 JWT 鉴权。"""
+from ipaddress import ip_address
+from secrets import token_urlsafe
+from urllib.parse import urlsplit
+from uuid import uuid4
+
+from fastapi import HTTPException, Request
+from sqlalchemy import select, text
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from app.config import get_settings
+from app.models import User
+from app.models_settings import AppSettings
+from app.services.auth import hash_password
+
+
+def require_local_studio_request(request: Request) -> None:
+    """仅允许本机应用来源领取会话，拒绝远程来源和伪造的宿主地址。"""
+    settings = get_settings()
+    if not settings.studio_single_user:
+        raise HTTPException(status_code=404, detail="本地单用户模式未启用")
+    try:
+        local_peer = request.client is not None and ip_address(request.client.host).is_loopback
+    except ValueError:
+        local_peer = False
+    origins = {settings.public_base_url.rstrip("/")}
+    origins.update(value.strip().rstrip("/") for value in settings.studio_local_origins.split(",") if value.strip())
+    origin = request.headers.get("origin", "")
+    parsed = urlsplit(origin)
+    local_hosts = {"127.0.0.1", "localhost", "::1"}
+    if (
+        not local_peer
+        or request.url.hostname not in local_hosts
+        or parsed.scheme not in {"http", "https"}
+        or parsed.hostname not in local_hosts
+        or parsed.path
+        or parsed.query
+        or parsed.fragment
+        or origin not in origins
+        or request.headers.get("x-printfilm-local") != "1"
+    ):
+        raise HTTPException(status_code=403, detail="仅允许本机工作室建立会话")
+
+
+async def get_local_studio_user(db: AsyncSession) -> User:
+    """单独保存本机身份绑定，保留已有用户、项目及默认模型配置。"""
+    settings = get_settings()
+    # 事务锁覆盖首次创建和绑定写入，多个窗口同时打开也使用同一个账号。
+    await db.execute(text("SELECT pg_advisory_xact_lock(1347634771)"))
+    binding = await db.get(AppSettings, "studio-local")
+    user_id = settings.studio_local_user_id
+    if user_id is None and binding is not None:
+        user_id = (binding.config_json or {}).get("user_id")
+        if type(user_id) is not int:
+            raise HTTPException(status_code=409, detail="本机账号绑定无效，请检查工作室配置")
+    if user_id is not None:
+        user = await db.get(User, user_id)
+        if user is None:
+            raise HTTPException(status_code=409, detail="本机绑定账号不存在，请检查 STUDIO_LOCAL_USER_ID")
+    else:
+        result = await db.execute(select(User).order_by(User.id).limit(2))
+        users = list(result.scalars())
+        if len(users) > 1:
+            raise HTTPException(status_code=409, detail="检测到多个账号，请通过 STUDIO_LOCAL_USER_ID 指定本机账号")
+        user = users[0] if users else User(
+            email="local-" + uuid4().hex + "@example.com",
+            nickname="本机工作室",
+            hashed_password=hash_password(token_urlsafe(32)),
+            role="admin",
+            quota_left=settings.new_user_quota,
+            balance_fen=0,
+        )
+        if not users:
+            db.add(user)
+            await db.flush()
+    if binding is None:
+        db.add(AppSettings(id="studio-local", config_json={"user_id": user.id}))
+    elif (binding.config_json or {}).get("user_id") != user.id:
+        binding.config_json = {"user_id": user.id}
+    await db.commit()
+    return user
diff --git a/backend/tests/test_local_studio_mode.py b/backend/tests/test_local_studio_mode.py
new file mode 100644
index 0000000..8279ae3
--- /dev/null
+++ b/backend/tests/test_local_studio_mode.py
@@ -0,0 +1,124 @@
+"""本机来源校验与固定账号选择的回归测试，不访问业务数据库。"""
+import unittest
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, patch
+
+from fastapi import HTTPException
+from pydantic import EmailStr, TypeAdapter
+from starlette.requests import Request
+
+from app.models import User
+from app.models_settings import AppSettings
+from app.services.local_studio import get_local_studio_user, require_local_studio_request
+
+
+def local_settings(**changes):
+    values = dict(studio_single_user=True, public_base_url="http://127.0.0.1:33102", studio_local_user_id=None, studio_local_origins="", new_user_quota=5)
+    values.update(changes)
+    return SimpleNamespace(**values)
+
+
+def local_request(peer="127.0.0.1", host="127.0.0.1:33104", origin="http://127.0.0.1:33102", marker="1"):
+    return Request({"type": "http", "method": "POST", "scheme": "http", "path": "/api/auth/local-session", "query_string": b"", "server": ("127.0.0.1", 33104), "client": (peer, 40000), "headers": [(b"host", host.encode()), (b"origin", origin.encode()), (b"x-printfilm-local", marker.encode())]})
+
+
+class LocalRequestTests(unittest.TestCase):
+    def test_accepts_only_enabled_local_application(self):
+        with patch("app.services.local_studio.get_settings", return_value=local_settings()):
+            require_local_studio_request(local_request())
+            require_local_studio_request(local_request(peer="::1"))
+
+    def test_explicit_local_admin_origin_is_allowed(self):
+        with patch("app.services.local_studio.get_settings", return_value=local_settings(studio_local_origins="http://127.0.0.1:33103")):
+            require_local_studio_request(local_request(origin="http://127.0.0.1:33103"))
+
+    def test_configured_remote_origin_remains_forbidden(self):
+        with patch("app.services.local_studio.get_settings", return_value=local_settings(studio_local_origins="https://remote.example")):
