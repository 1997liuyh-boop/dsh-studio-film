+import { useEffect, useState, type ReactNode } from 'react'
+import { prepareLocalAdminSession } from '@/lib/localStudioSession'
+
+/** 模型管理页复用同一本机身份，其他部署继续使用原管理员登录。 */
+export default function LocalStudioSession({ children }: { children: ReactNode }) {
+  const [ready, setReady] = useState(false)
+  const [error, setError] = useState('')
+  const [attempt, setAttempt] = useState(0)
+  useEffect(() => {
+    let active = true
+    prepareLocalAdminSession().then(() => { if (active) setReady(true) }).catch(error => {
+      if (active) setError(error instanceof Error ? error.message : '本机服务暂不可用。')
+    })
+    return () => { active = false }
+  }, [attempt])
+  if (ready) return children
+  return <main className="grid min-h-screen place-items-center p-6"><section className="max-w-md space-y-4" aria-live="polite">
+    <h1 className="text-xl font-semibold">{error ? '模型管理暂未连接' : '正在打开模型管理'}</h1>
+    {error && <><p role="alert" className="text-sm">{error}</p><button type="button" className="rounded-md border px-4 py-2 text-sm" onClick={() => { setError(''); setAttempt(value => value + 1) }}>重新连接</button></>}
+  </section></main>
+}
