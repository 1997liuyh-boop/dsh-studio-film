@@ -0,0 +1,21 @@
+import { useEffect, useState, type ReactNode } from 'react'
+import { prepareLocalStudioSession } from '../../lib/localStudioSession'
+
+/** 在路由和业务请求挂载前取得本机会话，避免登录页闪现与匿名请求。 */
+export default function LocalStudioSession({ children }: { children: ReactNode }) {
+  const [ready, setReady] = useState(false)
+  const [error, setError] = useState('')
+  const [attempt, setAttempt] = useState(0)
+  useEffect(() => {
+    let active = true
+    prepareLocalStudioSession().then(() => { if (active) setReady(true) }).catch(error => {
+      if (active) setError(error instanceof Error ? error.message : '工作台暂时无法连接。')
+    })
+    return () => { active = false }
+  }, [attempt])
+  if (ready) return children
+  return <main className="auth-shell"><section className="auth-panel" aria-live="polite">
+    <h1>{error ? '工作台连接失败' : '正在打开工作台'}</h1>
+    {error && <><p role="alert">{error}</p><button type="button" className="pf-btn pf-btn-primary" onClick={() => { setError(''); setAttempt(value => value + 1) }}>重新连接</button></>}
+  </section></main>
+}
